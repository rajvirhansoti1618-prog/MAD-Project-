{
  "rules": {
    "workspaces": {
      "$workspaceId": {
        ".read": "auth != null",
        ".write": "auth != null",
        "clients": {
          "$clientId": {
            ".validate": "newData.hasChildren(['id', 'updatedAt'])"
          }
        },
        "cases": {
          "$caseId": {
            ".validate": "newData.hasChildren(['id', 'updatedAt'])"
          }
        },
        "tasks": {
          "$taskId": {
            ".validate": "newData.hasChildren(['id', 'updatedAt'])"
          }
        },
        "notes": {
          "$noteId": {
            ".validate": "newData.hasChildren(['id', 'updatedAt'])"
          }
        },
        "reminders": {
          "$reminderId": {
            ".validate": "newData.hasChildren(['id', 'updatedAt'])"
          }
        },
        "draft_templates": {
          "$draftId": {
            ".validate": "newData.hasChildren(['id', 'updatedAt'])"
          }
        }
      }
    },
    ".read": false,
    ".write": false
  }
}
